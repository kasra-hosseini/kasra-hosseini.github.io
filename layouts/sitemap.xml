{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range .Data.Pages }}
  {{- /* Taxonomy and term pages (tags, categories) are noindexed; keep them out of the sitemap so crawl budget goes to real content. */}}
  {{- if not (in (slice "taxonomy" "term") .Kind) }}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML (.Lastmod.Format "2006-01-02T15:04:05-07:00") }}</lastmod>{{ end }}
  </url>
  {{- end }}
  {{- end }}
</urlset>
